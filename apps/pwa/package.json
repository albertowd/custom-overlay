{
  "author": "Alberto",
  "description": "Custom Overlay web application (PWA)",
  "devDependencies": {
    "@custom-overlay/core": "^0.1.0",
    "@custom-overlay/ui": "^0.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5"
  },
  "license": "AGPL-3.0-only",
  "name": "@custom-overlay/pwa",
  "private": true,
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../../scripts/normalize-lcov.mjs coverage/lcov.info",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit"
