{
  "author": "Alberto",
  "dependencies": {
    "@napi-rs/canvas": "1.0.13",
    "ffmpeg-static": "5.3.0"
  },
  "description": "Custom Overlay desktop application",
  "devDependencies": {
    "@custom-overlay/core": "^0.1.0",
    "@custom-overlay/ui": "^0.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5"
  },
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "name": "@custom-overlay/desktop",
  "private": true,
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "package": "electron-vite build && electron-builder",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../../scripts/normalize-lcov.mjs coverage/lcov.info",
    "test:watch": "vitest"
  },
  "version": "0.1.0"
}
